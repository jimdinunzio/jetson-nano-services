[Unit]
Description=DOFBOT Arm XML-RPC Server (ROS 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/jim/Documents/git/jetson-nano-services/arm-service/start_arm_server.sh
Restart=on-failure
RestartSec=5
User=jim
Environment=HOME=/home/jim
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ROS_DISTRO=humble
# Override the workspace, port or launch log here if needed:
# Environment=DOFBOT_WS=/home/jim/ros2_ws
# Environment=DOFBOT_ARM_PORT=8001
# Environment=DOFBOT_LAUNCH_LOG=/tmp/dofbot_arm_launch.log

# Graceful shutdown: the server needs long enough to let go of whatever is in
# the jaws AND bring the ROS launch down before systemd loses patience. Worst
# case, from arm_server's own timeouts:
#
#   11s  kill the command in flight   (SIGINT 3 + SIGTERM 5 + SIGKILL 3)
#    8s  open the jaws                (RELEASE_TIMEOUT)
#   16s  stop the launch              (SIGINT 8 + SIGTERM 5 + SIGKILL 3)
#   ---
#   35s  worst case, inside the limit below
#
# Those numbers are sized TO this limit, not the other way round. Raising any of
# them without raising this means systemd SIGKILLs the server mid-teardown,
# which is how move_group gets orphaned and how the jaws stay shut on a can.
TimeoutStopSec=45
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
