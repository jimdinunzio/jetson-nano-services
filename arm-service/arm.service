[Unit]
Description=Arm XML-RPC Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/jim/Documents/git/jetson-nano-services/arm-service/start_arm_server.sh
Restart=on-failure
RestartSec=5
User=jim
Environment=HOME=/home/jim
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Override the serial device here if needed:
# Environment=ARM_SERIAL_PORT=/dev/ttyTHS1

# Timeout settings for graceful shutdown.
# Give SIGTERM 30 seconds, then send SIGKILL.
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
