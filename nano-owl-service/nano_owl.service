[Unit]
Description=NanoOWL Server
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/home/jim/Documents/git/jetson-nano-services/nano-owl-service/start_nano_owl_server.sh
ExecStop=/bin/sh -c '/usr/bin/docker kill --signal=SIGINT nano_owl_server >/dev/null 2>&1 && timeout 2 /usr/bin/docker wait nano_owl_server >/dev/null 2>&1; /usr/bin/docker kill nano_owl_server >/dev/null 2>&1; exit 0'
Restart=no
User=jim
Environment=HOME=/home/jim
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Stopping is deliberately abrupt: ExecStop above interrupts the container the
# way Ctrl-C would, waits up to 2s for it to exit, then kills it. `docker stop`
# spent a grace period per call and a GPU switch cannot afford it. This timeout
# only has to outlast that.
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
