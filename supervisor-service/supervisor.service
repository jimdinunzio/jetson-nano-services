[Unit]
Description=Service Supervisor (NanoOWL/Live-VLM switch)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/home/jim/Documents/git/jetson-nano-services/supervisor-service/start_supervisor.sh
Restart=on-failure
RestartSec=5
User=jim
Environment=HOME=/home/jim
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Timeout settings for graceful shutdown.
# Give SIGTERM 30 seconds, then send SIGKILL.
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
